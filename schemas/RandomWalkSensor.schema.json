{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "file:///RandomWalkSensor.schema.json",
    "allOf": [
        {
            "$ref": "Sensor.schema.json"
        },
        {
            "type": "object",
            "properties": {
                "type": {
                    "enum": [
                        "ACCELEROMETER",
                        "GYROSCOPE"
                    ]
                },
                "frequency": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                },
                "noise_density": {
                    "description": "Two-sided white-noise density (units/sqrt(Hz)): ARW/VRW = Allan deviation at 1 s.",
                    "type": "number",
                    "exclusiveMinimum": 0.0
                },
                "bias_noise_density": {
                    "description": "Density of the white noise driving the bias (units/s/sqrt(Hz)): rate random walk.",
                    "type": "number",
                    "exclusiveMinimum": 0.0
                },
                "initial_noise": {
                    "description": "Standard deviation of the bias at sensor boot (units).",
                    "type": "number",
                    "exclusiveMinimum": 0.0
                },
                "scaling": {
                    "description": "Axis scaling matrix S (scalar or per-axis vector); applies S^-1.",
                    "oneOf": [
                        {
                            "type": "number",
                            "exclusiveMinimum": 0.0
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "number",
                                "exclusiveMinimum": 0.0
                            },
                            "minItems": 1
                        }
                    ]
                }
            },
            "required": [
                "frequency",
                "noise_density",
                "bias_noise_density",
                "initial_noise"
            ]
        }
    ]
}
